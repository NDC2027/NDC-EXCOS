rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /excoMembers/{memberId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
    match /excoMedia/{mediaId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 500000;
      allow read, update, delete: if isAdmin();
    }
    match /publicCardVerification/{membershipNo} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
